{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/config", "src/worker", "src/core", "test", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "src/frontend", "out", ".next", ".wrangler"]
}
