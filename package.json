{
  "name": "coverage-sourcing-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "特定エリア×季節の風景写真を、条件を満たす数だけ集める素材調達のデモ",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:web": "next dev src/frontend --port 3000",
    "dev:api": "wrangler dev --port 8787",
    "dev": "concurrently -k -n web,api -c blue,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "build:web": "next build src/frontend",
    "db:migrate:local": "node scripts/db-migrate-local.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "exifr": "7.1.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.5",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  }
}
